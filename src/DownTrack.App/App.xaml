<Application x:Class="DownTrack.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Border" Color="#E1E5EC"/>
    <SolidColorBrush x:Key="Text" Color="#1A2230"/>
    <SolidColorBrush x:Key="Muted" Color="#667185"/>
    <SolidColorBrush x:Key="Accent" Color="#5B5BD6"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,9"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
  </Application.Resources>
</Application>