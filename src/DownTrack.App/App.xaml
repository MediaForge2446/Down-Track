<Application
    x:Class="DownTrack.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="AppBg" Color="#F7F8FB" />
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2" Color="#F2F4F8" />
      <SolidColorBrush x:Key="Border" Color="#E1E5EC" />
      <SolidColorBrush x:Key="Text" Color="#1A2230" />
      <SolidColorBrush x:Key="Muted" Color="#667185" />
      <SolidColorBrush x:Key="Accent" Color="#5B5BD6" />
      <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SideBarBackground" Color="#F1F3F7" />
      <SolidColorBrush x:Key="SearchBackground" Color="#F4F5F8" />
      <SolidColorBrush x:Key="IconBackground" Color="#ECEEF5" />
      <SolidColorBrush x:Key="AccentSoft" Color="#EAEAFF" />
      <SolidColorBrush x:Key="PendingBackground" Color="#FFF8EA" />
      <SolidColorBrush x:Key="PendingBorder" Color="#F0D49F" />
      <SolidColorBrush x:Key="StatusSavedBrush" Color="#10B981" />
      <SolidColorBrush x:Key="StatusPendingBrush" Color="#F59E0B" />
      <SolidColorBrush x:Key="PendingText" Color="#9A6700" />

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
      </Style>

      <Style x:Key="Primary" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>

      <Style x:Key="Nav" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>