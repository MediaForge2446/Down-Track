<ui:FluentWindow
    x:Class="DownTrack.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownTrack"
    Width="1440"
    Height="900"
    MinWidth="1050"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBg}"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid Margin="18,8,18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="284" />
        </Grid.ColumnDefinitions>

        <!-- Main workspace -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Library -->
            <Grid Grid.Row="0" Visibility="{Binding LibraryVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,18,8,18">
                    <TextBlock Text="{Binding LibraryTitle, Mode=OneWay}"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LibrarySubtitle, Mode=OneWay}"
                               Foreground="{DynamicResource Muted}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="22"
                        Margin="8,0,8,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding RootFoldersTitle, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RootFoldersSubtitle, Mode=OneWay}"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,5,0,16" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RootFolders, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2}"
                                                BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Muted}"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <ui:Button Grid.Column="1"
                                                           Content="{Binding OpenText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Tag="{Binding}"
                                                           Appearance="Primary"
                                                           Padding="16,8"
                                                           Click="RootCard_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding RootEmptyVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="20">
                            <Border Width="68"
                                    Height="68"
                                    CornerRadius="20"
                                    Background="{DynamicResource AccentSoft}">
                                <TextBlock Text="+"
                                           FontSize="34"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EmptyLibraryText, Mode=OneWay}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding EmptyLibraryHint, Mode=OneWay}"
                                       Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="520"
                                       Margin="0,6,0,0" />
                            <ui:Button Content="{Binding AddRootText, Mode=OneWay}"
                                       Appearance="Primary"
                                       Margin="0,16,0,0"
                                       Padding="18,9"
                                       Click="AddRoot_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding RootEmptyHint, Mode=OneWay}"
                                   Foreground="{DynamicResource Muted}"
                                   Margin="2,14,2,0"
                                   Visibility="{Binding RootEmptyVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Explorer -->
            <Grid Grid.Row="0" Visibility="{Binding ExplorerVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="8,18,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Secondary"
                                   Content="←"
                                   Width="38"
                                   Height="36"
                                   Click="Back_Click"
                                   Margin="0,0,5,0" />
                        <ui:Button Appearance="Secondary"
                                   Content="→"
                                   Width="38"
                                   Height="36"
                                   Click="Forward_Click"
                                   Margin="0,0,5,0" />
                        <ui:Button Appearance="Secondary"
                                   Content="{Binding HomeText, Mode=OneWay}"
                                   Height="36"
                                   Padding="14,0"
                                   Click="Home_Click" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Margin="12,0"
                            Height="36"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Breadcrumb, Mode=OneWay}"
                                   Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center"
                                   Padding="12,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ExplorerTitle, Mode=OneWay}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="9"
                        Margin="8,0,8,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SearchBackground}"
                                 BorderThickness="0"
                                 FontSize="14" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="10,0,0,0">
                            <ui:Button Appearance="Secondary"
                                       Content="{Binding AllText, Mode=OneWay}"
                                       Click="All_Click"
                                       Margin="0,0,4,0" />
                            <ui:Button Appearance="Secondary"
                                       Content="MP3"
                                       Click="Mp3_Click"
                                       Margin="0,0,4,0" />
                            <ui:Button Appearance="Secondary"
                                       Content="MP4"
                                       Click="Mp4_Click" />
                        </StackPanel>

                        <ui:Button Grid.Column="2"
                                   Appearance="Secondary"
                                   Content="↻"
                                   Width="42"
                                   Height="38"
                                   Margin="10,0,0,0"
                                   Click="Refresh_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Margin="8,0,8,12">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource Surface2}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding NameHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormatHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding DurationHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding StatusHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding Items, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,2">
                                            <Grid MinHeight="58">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        Background="{DynamicResource IconBackground}"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="♫"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource Accent}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Muted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FormatLabel}"
                                                           Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SizeLabel}"
                                                           Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Duration}"
                                                           Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="5"
                                                        Background="{Binding StatusBrush}"
                                                        Padding="9,5"
                                                        CornerRadius="10"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="12" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Visibility="{Binding EmptyItemsVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <TextBlock Text="♫"
                                           FontSize="42"
                                           Foreground="{DynamicResource Muted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText, Mode=OneWay}"
                                           Foreground="{DynamicResource Muted}"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Settings -->
            <Grid Grid.Row="0" Visibility="{Binding SettingsVisibility, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,18,8,28">
                        <TextBlock Text="{Binding SettingsText, Mode=OneWay}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SettingsSubtitle, Mode=OneWay}"
                                   Foreground="{DynamicResource Muted}"
                                   Margin="0,5,0,22" />

                        <Border Style="{StaticResource Card}"
                                Padding="20"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding MediaPreferencesText, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FormatText, Mode=OneWay}"
                                                   Foreground="{DynamicResource Muted}" />
                                        <ComboBox ItemsSource="{Binding Formats, Mode=OneWay}"
                                                  SelectedItem="{Binding DefaultFormat, Mode=TwoWay}"
                                                  Width="170"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding QualityText, Mode=OneWay}"
                                                   Foreground="{DynamicResource Muted}" />
                                        <ComboBox ItemsSource="{Binding Bitrates, Mode=OneWay}"
                                                  SelectedItem="{Binding DefaultBitrate, Mode=TwoWay}"
                                                  Width="170"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Padding="20"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding LanguageText, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Languages, Mode=OneWay}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          Width="270"
                                          HorizontalAlignment="Left"
                                          Margin="0,10,0,0" />

                                <TextBlock Text="{Binding AppearanceText, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,22,0,0" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">
                                    <RadioButton Content="{Binding SystemText, Mode=OneWay}"
                                                 GroupName="theme"
                                                 IsChecked="{Binding SystemTheme, Mode=TwoWay}"
                                                 Margin="0,0,18,0" />
                                    <RadioButton Content="{Binding LightText, Mode=OneWay}"
                                                 GroupName="theme"
                                                 IsChecked="{Binding LightTheme, Mode=TwoWay}"
                                                 Margin="0,0,18,0" />
                                    <RadioButton Content="{Binding DarkText, Mode=OneWay}"
                                                 GroupName="theme"
                                                 IsChecked="{Binding DarkTheme, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Padding="20"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding EngineText, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EngineSummary, Mode=OneWay}"
                                           Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <ui:Button Appearance="Secondary"
                                           Content="{Binding CheckEngineText, Mode=OneWay}"
                                           HorizontalAlignment="Left"
                                           Margin="0,14,0,0"
                                           Click="Engine_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding AboutText, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="DownTrack • Native Windows downloader"
                                           Foreground="{DynamicResource Muted}"
                                           Margin="0,6,0,0" />
                                <ui:Button Appearance="Secondary"
                                           Content="{Binding CheckUpdatesText, Mode=OneWay}"
                                           HorizontalAlignment="Left"
                                           Margin="0,14,0,0"
                                           Click="Updates_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Toast -->
            <Border Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,18"
                    Background="{DynamicResource ToastSurface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="14,10"
                    Visibility="{Binding ToastVisibility, Mode=OneWay}"
                    Panel.ZIndex="30">
                <TextBlock Text="{Binding ToastText, Mode=OneWay}"
                           Foreground="{DynamicResource AccentForeground}" />
            </Border>

            <!-- Floating Add Media dialog -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  Background="{DynamicResource OverlayScrim}"
                  Visibility="{Binding DownloadVisibility, Mode=OneWay}"
                  Panel.ZIndex="50">
                <Border Width="740"
                        MaxHeight="700"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding AddMediaText, Mode=OneWay}"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DownloadHint, Mode=OneWay}"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,5,0,18" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UrlBox"
                                     Height="48"
                                     FontSize="15"
                                     Padding="14,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Url_Changed" />
                            <ui:Button Grid.Column="1"
                                       Appearance="Secondary"
                                       Content="{Binding PasteText, Mode=OneWay}"
                                       Width="90"
                                       Margin="10,0,0,0"
                                       Click="Paste_Click" />
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{DynamicResource ModalSurface}"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="140"
                                        Height="140"
                                        Background="{DynamicResource IconBackground}"
                                        CornerRadius="12">
                                    <Image x:Name="PreviewImage"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="18,0,0,0">
                                    <TextBlock Text="{Binding PreviewText, Mode=OneWay}"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="12" />
                                    <TextBox x:Name="NameBox"
                                             Text="New YouTube media"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Padding="10,8"
                                             Margin="0,8,0,10" />
                                    <TextBlock x:Name="PreviewMeta"
                                               Text="{Binding PreviewHint, Mode=OneWay}"
                                               Foreground="{DynamicResource Muted}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding FormatText, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Margin="0,18,0,7" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Mp3"
                                                     Content="Audio · MP3"
                                                     IsChecked="True"
                                                     GroupName="fmt"
                                                     Margin="0,0,18,0" />
                                        <RadioButton x:Name="Mp4"
                                                     Content="Video · MP4"
                                                     GroupName="fmt" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding QualityText, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Margin="0,13,0,7" />
                                    <ComboBox x:Name="Quality"
                                              Width="170"
                                              HorizontalAlignment="Left"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="128 kbps" />
                                        <ComboBoxItem Content="192 kbps" />
                                        <ComboBoxItem Content="256 kbps" />
                                        <ComboBoxItem Content="320 kbps" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,18,0,0">
                            <ui:Button Appearance="Secondary"
                                       Content="{Binding CancelText, Mode=OneWay}"
                                       Width="110"
                                       Click="CancelDownload_Click" />
                            <ui:Button Appearance="Primary"
                                       Content="{Binding AddToLibraryText, Mode=OneWay}"
                                       Width="165"
                                       Margin="10,0,0,0"
                                       Click="AddToLibrary_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Right rail: brand, roots, pending, settings -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="10,16,10,18">
                <TextBlock Text="DownTrack"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" />
            </StackPanel>

            <ui:Button Grid.Row="1"
                       Content="{Binding AddRootText, Mode=OneWay}"
                       Style="{StaticResource Primary}"
                       Height="40"
                       Click="AddRoot_Click"
                       Margin="10,0,10,12" />

            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="10"
                    Margin="10,0,10,12">
                <StackPanel>
                    <TextBlock Text="{Binding FoldersText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{DynamicResource Muted}"
                               Margin="4,1,0,7" />
                    <ListBox ItemsSource="{Binding RootFolders, Mode=OneWay}"
                             SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                             SelectionChanged="RootList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9"
                                        CornerRadius="8"
                                        Background="{DynamicResource Surface2}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▱"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="17"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding RootEmptyHint, Mode=OneWay}"
                               Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap"
                               Margin="5,7,5,3" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource Card}"
                    Padding="12"
                    Margin="10,0,10,10"
                    Visibility="{Binding PendingVisibility, Mode=OneWay}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding PendingText, Mode=OneWay}"
                                   FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource PendingSurface}"
                                CornerRadius="8"
                                Padding="8,3">
                            <TextBlock Text="{Binding PendingChanges.Count, Mode=OneWay}"
                                       Foreground="{DynamicResource PendingText}"
                                       FontSize="11" />
                        </Border>
                    </Grid>

                    <ScrollViewer MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingChanges, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="11" />
                                        <ProgressBar Grid.Row="1"
                                                     Grid.ColumnSpan="2"
                                                     Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress}"
                                                     Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Appearance="Secondary"
                                   Content="{Binding CancelText, Mode=OneWay}"
                                   Click="CancelPending_Click"
                                   Margin="0,0,4,0" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Content="{Binding SaveText, Mode=OneWay}"
                                   Click="Save_Click"
                                   Margin="4,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <ui:Button Grid.Row="4"
                       Content="⚙  {Binding SettingsText, Mode=OneWay}"
                       Style="{StaticResource Nav}"
                       Height="40"
                       Margin="10,0,10,2"
                       Click="Settings_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>