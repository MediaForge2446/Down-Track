<Window x:Class="DownTrack.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="DownTrack" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#F0F2F6" BorderBrush="#E0E4EB" BorderThickness="0,0,1,0">
      <Grid Margin="18,18,16,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="22" Background="{DynamicResource Accent}"><TextBlock Text="D" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="11,0,0,0"><TextBlock Text="DownTrack" FontSize="20" FontWeight="Bold"/><TextBlock Text="Native Windows app" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel>
          </StackPanel>
          <ui:Button Content="{Binding AddMediaText, Mode=OneWay}" Style="{StaticResource Primary}" Height="44" Margin="0,20,0,8" Click="AddMedia_Click"/>
          <ui:Button Appearance="Secondary" Content="{Binding AddRootText}" Height="40" Click="AddRoot_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,10" Padding="10">
          <StackPanel>
            <TextBlock Text="{Binding FoldersText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0,0,7"/>
            <ListBox ItemsSource="{Binding RootFolders, Mode=OneWay}" SelectedItem="{Binding SelectedRoot, Mode=TwoWay}" SelectionChanged="RootList_SelectionChanged" BorderThickness="0" Background="Transparent">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Border Padding="9,9" CornerRadius="8"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding RootEmptyHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="5,6,5,3"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
          <TextBlock Text="{Binding LibraryToolsText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="5,6,0,7"/>
          <ui:Button Content="{Binding AddFolderText}" Style="{StaticResource Nav}" Click="AddFolder_Click"/>
          <ui:Button Content="{Binding RenameText}" Style="{StaticResource Nav}" Click="Rename_Click"/>
          <ui:Button Content="{Binding DeleteText}" Style="{StaticResource Nav}" Click="Delete_Click"/>
        </StackPanel>
        <ui:Button Grid.Row="3" Content="{Binding SettingsText, Mode=OneWay}" Style="{StaticResource Nav}" Click="Settings_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- Library -->
      <Grid Grid.Row="0" Visibility="{Binding LibraryVisibility, Mode=OneWay}">
        <StackPanel Margin="28,24,28,26">
          <TextBlock Text="{Binding LibraryTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LibrarySubtitle, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,6,0,24"/>
          <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
              <TextBlock Text="{Binding RootFoldersTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding RootFoldersSubtitle, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,5,0,16"/>
              <ItemsControl ItemsSource="{Binding RootFolders, Mode=OneWay}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Background="#F7F8FB" BorderBrush="#E5E8EE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding}" FontWeight="SemiBold"/><TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                      <ui:Button Grid.Column="1" Content="{Binding OpenText}" Tag="{Binding}" Padding="14,8" Click="RootCard_Click" Style="{StaticResource Primary}"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding RootEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,28,0,20">
                <Border Width="62" Height="62" CornerRadius="18" Background="#EAEAFF"><TextBlock Text="＋" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="{Binding EmptyLibraryText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding EmptyLibraryHint, Mode=OneWay}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <ui:Button Content="{Binding AddRootText}" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="AddRoot_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Explorer -->
      <Grid Grid.Row="0" Visibility="{Binding ExplorerVisibility, Mode=OneWay}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="24,20,24,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Breadcrumb, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ExplorerTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ui:Button Appearance="Secondary" Grid.Column="1" Content="←" Width="42" Height="38" Margin="8,8,0,0" Click="Back_Click"/>
          <ui:Button Appearance="Secondary" Grid.Column="2" Content="→" Width="42" Height="38" Margin="6,8,0,0" Click="Forward_Click"/>
          <ui:Button Appearance="Secondary" Grid.Column="3" Content="{Binding HomeText, Mode=OneWay}" Height="38" Margin="6,8,0,0" Click="Home_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,10" Padding="10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="12,0" VerticalContentAlignment="Center" Background="#F4F5F8" BorderThickness="0" FontSize="14"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><ui:Button Appearance="Secondary" Content="{Binding AllText, Mode=OneWay}" Click="All_Click" Margin="0,0,4,0"/><ui:Button Appearance="Secondary" Content="MP3" Click="Mp3_Click" Margin="0,0,4,0"/><ui:Button Appearance="Secondary" Content="MP4" Click="Mp4_Click"/></StackPanel>
            <ui:Button Appearance="Secondary" Grid.Column="2" Content="↻" Width="44" Height="38" Margin="10,0,0,0" Click="Refresh_Click"/>
          </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,12">
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Background="#F7F8FB"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0"/><TextBlock Grid.Column="1" Text="{Binding NameHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding FormatHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding SizeHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding DurationHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding StatusHeader, Mode=OneWay}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              </Grid>
              <ListView Grid.Row="1" ItemsSource="{Binding Items, Mode=OneWay}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent">
                <ListView.ItemTemplate><DataTemplate><Grid Margin="0,2" MinHeight="58">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="36" Height="36" Background="#ECEEF5" CornerRadius="8" HorizontalAlignment="Center"><TextBlock Text="♫" FontSize="18" Foreground="#686BB0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding FormatLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  <Border Grid.Column="5" Background="{Binding StatusBrush}" Padding="9,5" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" FontSize="12"/></Border>
                </Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <StackPanel Visibility="{Binding EmptyItemsVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="42" Foreground="#B6BBC8" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyText, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Settings -->
      <Border Grid.Row="0" Background="{DynamicResource AppBg}" Visibility="{Binding SettingsVisibility, Mode=OneWay}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,20,28,30">
            <TextBlock Text="{Binding SettingsText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SettingsSubtitle, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,5,0,22"/>
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="{Binding LanguageText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLanguage}" Margin="0,10,0,0" Width="270" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding AppearanceText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><RadioButton Content="{Binding SystemText, Mode=OneWay}" GroupName="theme" IsChecked="{Binding SystemTheme}" Margin="0,0,20,0"/><RadioButton Content="{Binding LightText, Mode=OneWay}" GroupName="theme" IsChecked="{Binding LightTheme}" Margin="0,0,20,0"/><RadioButton Content="{Binding DarkText, Mode=OneWay}" GroupName="theme" IsChecked="{Binding DarkTheme}"/></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding MediaPreferencesText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FormatText, Mode=OneWay}" Foreground="{DynamicResource Muted}"/><ComboBox ItemsSource="{Binding Formats, Mode=OneWay}" SelectedItem="{Binding DefaultFormat}" Width="170" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding QualityText, Mode=OneWay}" Foreground="{DynamicResource Muted}"/><ComboBox ItemsSource="{Binding Bitrates, Mode=OneWay}" SelectedItem="{Binding DefaultBitrate}" Width="170" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding EngineText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding EngineSummary, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/><ui:Button Appearance="Secondary" Content="{Binding CheckEngineText, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Engine_Click"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="{Binding AboutText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="DownTrack 0.1.0 • Native Windows downloader" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><ui:Button Appearance="Secondary" Content="{Binding CheckUpdatesText, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Updates_Click"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Pending changes -->
      <Border Grid.Row="1" Style="{StaticResource Card}" Background="#FFF8EA" BorderBrush="#F0D49F" Margin="24,0,24,18" Padding="14,11" Visibility="{Binding PendingVisibility, Mode=OneWay}" Panel.ZIndex="10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Expander Header="{Binding PendingText, Mode=OneWay}" IsExpanded="False" Foreground="{DynamicResource PendingText}">
            <ScrollViewer MaxHeight="170" Margin="0,8,12,0"><ItemsControl ItemsSource="{Binding PendingChanges, Mode=OneWay}">
              <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="5" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,5,0,0"/>
              </Grid></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl></ScrollViewer>
          </Expander>
          <ui:Button Grid.Column="1" Content="{Binding SaveText, Mode=OneWay}" Style="{StaticResource Primary}" Padding="18,9" Click="Save_Click" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Toast -->
      <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,32" Background="#20242B" CornerRadius="10" Padding="14,10" Visibility="{Binding ToastVisibility, Mode=OneWay}" Panel.ZIndex="30">
        <TextBlock Text="{Binding ToastText, Mode=OneWay}" Foreground="White"/>
      </Border>

      <!-- Floating download modal -->
      <Grid Grid.Row="0" Grid.RowSpan="2" Background="#660D1320" Visibility="{Binding DownloadVisibility, Mode=OneWay}" Panel.ZIndex="50">
        <Border Width="740" MaxHeight="700" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="{Binding AddMediaText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding DownloadHint, Mode=OneWay}" Foreground="{DynamicResource Muted}" Margin="0,5,0,18"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlBox" Height="48" FontSize="15" Padding="14,0" VerticalContentAlignment="Center" TextChanged="Url_Changed"/><ui:Button Appearance="Secondary" Grid.Column="1" Content="{Binding PasteText, Mode=OneWay}" Width="90" Margin="10,0,0,0" Click="Paste_Click"/></Grid>
            <Border Grid.Row="2" Background="#F4F5FA" CornerRadius="14" Padding="16" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="140" Height="140" Background="#E9EAF2" CornerRadius="12"><Image x:Name="PreviewImage" Stretch="UniformToFill"/></Border>
              <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="{Binding PreviewText, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBox x:Name="NameBox" Text="New YouTube media" FontSize="18" FontWeight="SemiBold" Padding="10,8" Margin="0,8,0,10"/><TextBlock x:Name="PreviewMeta" Text="{Binding PreviewHint, Mode=OneWay}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding FormatText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,18,0,7"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="Mp3" Content="Audio · MP3" IsChecked="True" GroupName="fmt" Margin="0,0,18,0"/><RadioButton x:Name="Mp4" Content="Video · MP4" GroupName="fmt"/></StackPanel><TextBlock Text="{Binding QualityText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,13,0,7"/><ComboBox x:Name="Quality" Width="170" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="128 kbps"/><ComboBoxItem Content="192 kbps"/><ComboBoxItem Content="256 kbps"/><ComboBoxItem Content="320 kbps"/></ComboBox></StackPanel>
            </Grid></Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><ui:Button Appearance="Secondary" Content="{Binding CancelText, Mode=OneWay}" Width="110" Click="CancelDownload_Click"/><ui:Button Content="{Binding AddToLibraryText, Mode=OneWay}" Width="155" Margin="10,0,0,0" Style="{StaticResource Primary}" Click="AddToLibrary_Click"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>